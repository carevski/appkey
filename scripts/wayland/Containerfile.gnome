# GNOME Shell (Wayland, headless) for scripts/wayland/test-gnome.sh.
FROM docker.io/library/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False gnome-shell mutter foot dbus-daemon dbus-tools \
    glib2 dconf gsettings-desktop-schemas mesa-dri-drivers fontconfig dejavu-sans-fonts procps-ng \
    libxkbcommon-x11 libXcursor libXrandr libXi python3 python3-dbusmock \
    && dnf clean all
RUN useradd -m -u 1000 tester
USER tester
WORKDIR /home/tester
